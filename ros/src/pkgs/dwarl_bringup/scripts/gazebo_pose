#!/usr/bin/env python3
"""Publish map->odom from Gazebo truth and time-aligned odom->model TF."""

from collections import deque
from threading import Lock

import numpy as np
import rclpy
from dwarl_bringup.pose import matrix
from geometry_msgs.msg import TransformStamped
from gz.msgs10.pose_v_pb2 import Pose_V
from gz.transport13 import Node as GzNode
from rclpy.node import Node
from rclpy.time import Time
from scipy.spatial.transform import Rotation
from tf2_ros import Buffer, TransformBroadcaster, TransformException, TransformListener


class GazeboPose(Node):
    def __init__(self):
        super().__init__("gazebo_pose")
        for name, default in (
            ("world", "default"), ("model", "robot"), ("map_frame", "map"),
            ("odom_frame", "odom"), ("model_frame", "base_link"),
        ):
            self.declare_parameter(name, default)
        self.tf = Buffer()
        self.listener = TransformListener(self.tf, self)
        self.broadcaster = TransformBroadcaster(self)
        self.pending = deque(maxlen=200)
        self.lock = Lock()
        self.gz = GzNode()
        topic = f"/world/{self.value('world')}/dynamic_pose/info"
        if not self.gz.subscribe(Pose_V, topic, self.receive):
            raise RuntimeError(f"Could not subscribe to {topic}")
        self.timer = self.create_timer(0.01, self.publish)
        self.get_logger().info(f"Using Gazebo ground truth: {topic}, model={self.value('model')}")

    def value(self, name):
        return self.get_parameter(name).value

    def receive(self, message):
        for pose in message.pose:
            if pose.name.strip("/") == self.value("model"):
                stamp = message.header.stamp
                sample = (stamp.sec, stamp.nsec, matrix(pose.position, pose.orientation))
                with self.lock:
                    self.pending.append(sample)
                break

    def publish(self):
        with self.lock:
            samples = list(self.pending)
        # Use the newest truth sample for which odometry TF has arrived.
        for sec, nsec, truth in reversed(samples):
            stamp = Time(seconds=sec, nanoseconds=nsec)
            if stamp.nanoseconds == 0:
                continue
            try:
                odom = self.tf.lookup_transform(
                    self.value("odom_frame"), self.value("model_frame"), stamp
                ).transform
            except TransformException:
                continue
            correction = truth @ np.linalg.inv(matrix(odom.translation, odom.rotation))
            msg = TransformStamped()
            msg.header.stamp = stamp.to_msg()
            msg.header.frame_id = self.value("map_frame")
            msg.child_frame_id = self.value("odom_frame")
            translation = msg.transform.translation
            translation.x, translation.y, translation.z = map(float, correction[:3, 3])
            rotation = msg.transform.rotation
            rotation.x, rotation.y, rotation.z, rotation.w = map(
                float, Rotation.from_matrix(correction[:3, :3]).as_quat()
            )
            self.broadcaster.sendTransform(msg)
            with self.lock:
                while self.pending and self.pending[0][:2] <= (sec, nsec):
                    self.pending.popleft()
            return


def main():
    rclpy.init()
    node = GazeboPose()
    try:
        rclpy.spin(node)
    finally:
        node.destroy_node()
        if rclpy.ok():
            rclpy.shutdown()


if __name__ == "__main__":
    main()
