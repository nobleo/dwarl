<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>dwarl_bringup</name>
  <version>0.1.0</version>
  <description>Robot-agnostic launch files for the DWARL RL local planner: Nav2 configured from a policy bundle
    and a Gazebo scenario benchmark for any robot profile</description>
  <maintainer email="info@nobleo.nl">Nobleo Technology</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <exec_depend>dwarl_controller</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
