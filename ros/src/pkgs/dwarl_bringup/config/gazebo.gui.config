<?xml version="1.0"?>
<dialog name="quick_start" show_again="false"/>
<window>
  <style material_theme="Dark" material_accent="LightBlue"/>
</window>
<plugin filename="MinimalScene" name="3D View">
  <gz-gui><property type="bool" key="showTitleBar">false</property></gz-gui>
  <engine>ogre2</engine>
  <scene>scene</scene>
  <ambient_light>0.4 0.4 0.4</ambient_light>
  <background_color>0.10 0.11 0.13</background_color>
  <camera_pose>-6 0 6 0 0.5 0</camera_pose>
</plugin>
<plugin filename="GzSceneManager" name="Scene Manager">
  <gz-gui>
    <property key="state" type="string">floating</property>
    <property key="showTitleBar" type="bool">false</property>
    <property key="height" type="double">5</property>
    <property key="width" type="double">5</property>
  </gz-gui>
</plugin>
<plugin filename="InteractiveViewControl" name="Interactive view control">
  <gz-gui>
    <property key="state" type="string">floating</property>
    <property key="showTitleBar" type="bool">false</property>
    <property key="height" type="double">5</property>
    <property key="width" type="double">5</property>
  </gz-gui>
</plugin>
<plugin filename="WorldControl" name="World control">
  <gz-gui>
    <property key="state" type="string">floating</property>
    <property key="showTitleBar" type="bool">false</property>
    <anchors target="3D View"><line own="left" target="left"/><line own="bottom" target="bottom"/></anchors>
  </gz-gui>
  <play_pause>true</play_pause><step>true</step><use_event>true</use_event>
</plugin>
<plugin filename="ComponentInspector" name="Component inspector">
  <gz-gui><property key="state" type="string">docked_collapsed</property></gz-gui>
</plugin>
<plugin filename="EntityTree" name="Entity tree">
  <gz-gui><property key="state" type="string">docked_collapsed</property></gz-gui>
</plugin>
