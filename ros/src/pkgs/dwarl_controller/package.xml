<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>dwarl_controller</name>
  <version>0.1.0</version>
  <description>Nav2 controller plugin running a DWARL RL policy (ONNX Runtime)</description>
  <maintainer email="info@nobleo.nl">Nobleo Technology</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <nav2_core plugin="${prefix}/dwarl_controller_plugin.xml"/>
  </export>
</package>
